# =============================================================================
# 읽는 법
#   [필수]   없으면 배포 또는 기동이 실패한다
#   [조건부] 해당 기능을 켤 때만 필요. 켰는데 비면 배포가 거부된다
#   [배포]   deploy.ps1 가 Cloud Run 에 넘긴다 — 여기 값이 곧 운영 값
#   [개발자용] 배포가 안 넘긴다 — 여기서 바꿔도 **서비스에 반영 안 됨**.
#            코드 기본값이 곧 운영값이다. 파일 맨 아래로 모아 뒀다
#
# 주의
#   - deploy.ps1 는 --set-env-vars 로 env 를 통째로 치환한다. 안 넘긴 값은 사라진다
#   - 값에 따옴표를 쓰지 말 것 (일부 도구가 따옴표째 읽는다)
#   - 같은 변수를 두 번 적지 말 것 (로더마다 이기는 쪽이 다르다)
# =============================================================================

# --- 필수 ------------------------------------------------------------------
# GCP 프로젝트 ID
GCP_PROJECT_ID=your-project-id
# HWP/HWPX 원본 버킷 (파서 입력·재파싱 소스, 원본 공문 상주)
GCS_HWP_ORIGINAL_BUCKET=
# Vertex RAG import 산출물 버킷 (변환 MD·통과 PDF·사이드카)
GCS_SOURCE_BUCKET=
# 교직원(=전체) RAG 코퍼스. rag-sync 와 교직원 MCP 가 여기를 본다
RAG_CORPUS_NAME=projects/{project}/locations/asia-northeast3/ragCorpora/{corpus-id}
# 공유 드라이브 ID (쉼표 구분)
DRIVE_IDS=shared-drive-id-1,shared-drive-id-2
# 수집 대상 폴더 ID (Drive URL 의 folders/ 뒤, 쉼표 구분). 비우면 배포 거부
SYNC_FOLDER_IDS=
# 교직원 MCP 키. 배포 스크립트가 **MCP_API_KEY** 라는 이름으로 넘긴다
# (서버가 읽는 이름은 MCP_API_KEY 하나뿐이다)
#
# [학과 배포] deploy_mcp.ps1 -Dept <학과> 를 쓰면 이 파일을 아예 안 본다.
# 키는 config/departments/<학과>.yaml 의 keys 에 있다 (파일 아래쪽 참고).
# 아래 두 값은 -Dept 없이 도는 레거시 경로 전용이다.
MCP_API_KEY_STAFF=change-me-to-a-long-random-secret

# --- 조건부 필수 --------------------------------------------------------------
# 학생/교직원 분리를 켤 때. 아래 둘은 **짝** — 하나만 채우면 배포가 거부된다
# 비워두면 단일 코퍼스로 동작한다 (교직원만)
# 학생 RAG 코퍼스. [배포]
RAG_CORPUS_NAME_STUDENT=
# 학생 코퍼스에 실릴 폴더. SYNC_FOLDER_IDS 의 부분집합. [배포]
STUDENT_FOLDER_IDS=
# 학생 MCP 키. **MCP_API_KEY_STAFF 와 반드시 다른 값** (같으면 배포 거부)
# 학생 MCP 를 띄우려면 필요. deploy_mcp.ps1 이 MCP_API_KEY 로 넘긴다
# deploy.ps1 은 학생 서비스를 안 만든다 — MCP_AUDIENCE=student 로 deploy_mcp.ps1
MCP_API_KEY_STUDENT=
# QG_MODE=fallback 일 때만 필요. log 면 비워둔다. [배포]
DOCAI_PROCESSOR_ID=

# --- 배포 ------------------------------------------------------------------
# GCP 리전
GCP_REGION=asia-northeast3
# Native 모드 DB. (default) Datastore 는 불가. 사전 생성 필수
FIRESTORE_DATABASE=rag-sync-state
# 품질 게이트: log=경고만 | reject=422/DLQ | fallback=Document AI
QG_MODE=log
# Drive→GCS ingest 병렬 워커
INGEST_CONCURRENCY=8
# RagFile 삭제 동시수. 기본 1은 60rpm 쿼터 기준
RAG_DELETE_CONCURRENCY=1
# RagFile 삭제 간격(초). 소모율 ≈ 동시수 / (0.4 + 페이싱)
RAG_DELETE_PACING_SECONDS=1.1
# 교직원 Cloud Run 서비스 이름. gcloud 인자로만 쓰인다(Cloud Run env 아님)
# MCP_SERVICE_NAME 은 여기 적지 말 것 — 세션 오버라이드 전용
MCP_SERVICE_NAME_STAFF=rag-mcp-cs-staff
# 학생 Cloud Run 서비스 이름
MCP_SERVICE_NAME_STUDENT=rag-mcp-cs-student
# 검색 기본 k
TOP_K_DEFAULT=5
# retrieve 여유분 배수. postprocess 가 파일 단위로 접으므로 k 보다 많이 뽑는다
SEARCH_FETCH_MULTIPLIER=3
# retrieve 상한
SEARCH_FETCH_MAX=60
# 문서 상태 컬렉션. 컬렉션 5종 중 **이것만** 배포가 넘긴다
DOC_STATE_COLLECTION=doc_state

# --- 배포 스크립트 전용 (Cloud Run env 로 안 들어감) -------------------------
# Artifact Registry 리포지토리
ARTIFACT_REPO=rag-mcp
# rag-parser 타임아웃(초)
PARSER_TIMEOUT=540
# rag-parser 인스턴스당 동시 요청
PARSER_CONCURRENCY=4
# rag-parser 최대 인스턴스
PARSER_MAX_INSTANCES=10
# rag-sync 인스턴스당 동시 요청
SYNC_CONCURRENCY=4
# MCP 인스턴스당 동시 요청. deploy.ps1 과 deploy_mcp.ps1 이 같은 값을 쓴다
MCP_CONCURRENCY=40
# Scheduler 가 Workflows 를 부를 때 쓰는 SA
SCHEDULER_SA=scheduler@your-project-id.iam.gserviceaccount.com
# MCP 에 --allow-unauthenticated 를 줄지. deploy.ps1 / deploy_mcp.ps1 둘 다 이 값을 본다.
# true(기본) 여야 FactChat 커넥터가 붙는다 — 커넥터는 정적 헤더만 보내기 때문이다.
# 이때 경계는 앱 계층 키(MCP_API_KEY) 하나뿐이다. 키가 새면 그 코퍼스 전량이 열린다.
ALLOW_UNAUTH=true

# =============================================================================
# [개발자용] 아래는 배포가 Cloud Run 에 넘기지 않는다.
#            여기서 값을 바꿔도 **배포된 서비스는 코드 기본값을 쓴다**.
#            실제로 바꾸려면 deploy.ps1 의 --set-env-vars 에 먼저 추가할 것.
#            평상시 운영에서는 건드릴 일이 없다.
# =============================================================================

# --- 파이프라인 튜닝 ----------------------------------------------------------
# 우리 파일 크기 상한. PDF 분할을 쓰려면 RAG PDF 한도(50MB)보다 커야 한다
MAX_GCS_BYTES=157286400
# /sync/changes 한 번에 반환할 변경 건수 (Workflows 변수 512KB 상한)
SYNC_MAX_CHANGES=200
# RAG 청크 크기. 재색인해야 반영된다
RAG_CHUNK_SIZE=1024
# RAG 청크 오버랩. 코퍼스 바뀌면 analyze_chunking.py 로 표 절단율을 재고 고를 것
RAG_CHUNK_OVERLAP=256
# 품질 게이트: 텍스트 밀도 하한
QG_DENSITY_THRESHOLD=0.0005
# 품질 게이트: 표 손실 비율 상한
QG_TABLE_LOSS_RATIO=0.3
# 품질 게이트: 최소 텍스트 길이
QG_MIN_TEXT_LENGTH=20
# Document AI 폴백 사용 여부
ENABLE_DOCAI_FALLBACK=false
# Document AI 리전
DOCAI_LOCATION=asia-northeast3
# 검색 top_k 상한
SEARCH_TOP_K_MAX=20
# 벡터 거리 상한. 이보다 먼 청크는 버린다 (0 이면 필터 끔)
SEARCH_DISTANCE_THRESHOLD=0.30
# 어휘(BM25)+벡터 RRF 재정렬
SEARCH_LEXICAL_RERANK=true
# 파일당 최대 청크 수
SEARCH_MAX_CHUNKS_PER_FILE=3
# 응답 총 청크 수 상한
SEARCH_MAX_TOTAL_CHUNKS=15
# 아래 컬렉션 4종은 배포가 안 넘긴다. 이름을 바꾸려면 deploy.ps1 에 먼저 추가할 것
# (DOC_STATE_COLLECTION 만 [배포] 로 올라가 있어 비대칭이다)
# 실패 문서 컬렉션
DLQ_COLLECTION=doc_dlq
# 대용량 PDF 분할 대기 컬렉션
SPLIT_QUEUE_COLLECTION=doc_split_queue
# Drive Changes 토큰 컬렉션
SYNC_TOKEN_COLLECTION=sync_tokens
# 장시간 작업 진행률 컬렉션
SYNC_JOB_COLLECTION=sync_jobs

# --- MCP 서버 런타임 ----------------------------------------------------------
# 키 없이 기동 허용. 미설정이면 키 없는 기동은 거부
MCP_ALLOW_NO_AUTH=
# 검색 응답 캐시 TTL(초)
SEARCH_CACHE_TTL_SECONDS=60
# 검색 응답 캐시 최대 항목
SEARCH_CACHE_MAX_ENTRIES=128

# =============================================================================
# 학생/교직원 분리를 켜는 절차
#
# 코퍼스는 포함 관계다 — 교직원(전체) ⊇ 학생(STUDENT_FOLDER_IDS 트리)
# MCP 서버는 기동 시점의 코퍼스 하나만 본다. 툴 인자로 대상을 고르지 않는다
# (호출 LLM 이 정하는 값은 접근 통제가 될 수 없다). 그래서 **서비스를 두 벌 띄운다**
#
#   1) STUDENT_FOLDER_IDS / RAG_CORPUS_NAME_STUDENT 설정 후 rag-sync 재배포
#   2) 기존 문서의 audience 를 일괄 판정해 doc_state 에 기록
#      - audience 는 ingest 시점에만 기록된다(_resolve_audience)
#      - 이미 INDEXED 인 문서는 ingest 초입에서 UNCHANGED 로 빠져 그 코드에 못 간다
#      - reindex-pending 도 audience 를 다시 판정하지 않는다
#      - **이 단계를 건너뛰면 학생 코퍼스는 빈 채로 동작한다**
#   3) 학생 코퍼스 적재
#   4) 학생용 MCP 배포
#        $env:MCP_AUDIENCE = "student"
#        .\scripts\deploy_mcp.ps1
#
# 순서를 지킬 것. 4 를 먼저 하면 학생에게 빈 검색을 준다
# =============================================================================

# =============================================================================
# 학과별 배포 (config/ 로 분리됨)
#
# 학과가 늘면 값을 여기 계속 붙이지 않는다. 설정 원본이 옮겨갔다:
#
#   config/common.yaml               학과 무관 공통값        [커밋함]
#   config/departments/<학과>.yaml   코퍼스·**키**·폴더·상주수 [커밋 안 함]
#   config/departments/dept.yaml.example  그 템플릿            [커밋함]
#
# 실값 파일을 커밋하지 않는 이유는 키 때문이다. git 은 키를 회전해도
# 이력에 영구히 남기는 유일한 저장소다.
#
# **-Dept 를 쓰면 이 파일(.env)은 읽지 않는다.** 아래 RAG_CORPUS_NAME /
# MCP_SERVICE_NAME_* / MCP_API_KEY_* 는 -Dept 없이 도는 레거시 경로 전용이다.
# 두 곳을 같이 고치려 하지 말 것.
#
# 배포:
#   .\scripts\deploy_mcp.ps1 -Dept cs                    # 교직원
#   .\scripts\deploy_mcp.ps1 -Dept cs -Audience student  # 학생
#   .\scripts\deploy_mcp.ps1 -All                        # 전 학과 x 양쪽
#   .\scripts\deploy_mcp.ps1 -All -ShowKeys              # 요약표에 키 노출
#
# -All 은 이미지를 **한 번만** 빌드하고 그 digest 를 전 학과에 배포한다.
# 학과마다 빌드하면 의존성 해석이 갈려 학과별로 다른 코드가 돌 수 있다.
#
# 자세한 것은 config/departments/README.md
# =============================================================================
