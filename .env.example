# GCP
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-northeast3

# Buckets
GCS_RAW_BUCKET=rag-raw-{project}
GCS_NORMALIZED_BUCKET=rag-normalized-{project}

# Firestore — Native 모드 DB 이름. Datastore Mode인 (default) 는 사용 불가
FIRESTORE_DATABASE=doc-state
FIRESTORE_COLLECTION=doc_state

# Vertex AI RAG Engine
RAG_CORPUS_NAME=projects/{project}/locations/asia-northeast3/ragCorpora/{corpus-id}

# Document AI (optional; QG_MODE=fallback 일 때만)
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=asia-northeast3

# Drive
DRIVE_IDS=shared-drive-id-1,shared-drive-id-2
# 하위 폴더만 RAG/GCS (비우면 드라이브 전체). 폴더로 들어간 뒤 URL의 folders/ID
SYNC_FOLDER_IDS=

# Parser (rhwp-python) quality gates
QG_DENSITY_THRESHOLD=0.0005
QG_TABLE_FAIL_RATIO=0.3
QG_IMAGE_RATIO=0.5
QG_MIN_TEXT_LENGTH=20
# log=경고만 색인 계속 | reject=422/DLQ | fallback=Document AI
QG_MODE=log
ENABLE_DOCAI_FALLBACK=false

MAX_GCS_BYTES=52428800
DLQ_COLLECTION=doc_dlq
SPLIT_QUEUE_COLLECTION=doc_split_queue
# Drive→GCS ingest 병렬 (무료/2Gi 기준)
RAW_UPLOAD_CONCURRENCY=8

# MCP (FactChat 커넥터용 — scripts/deploy_mcp.sh)
MCP_API_KEY=change-me-to-a-long-random-secret
MCP_AUTH_AUDIENCE=
TOP_K_DEFAULT=5
