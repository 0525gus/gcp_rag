# GCP
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-northeast3

# Buckets
GCS_RAW_BUCKET=rag-raw-{project}
GCS_NORMALIZED_BUCKET=rag-normalized-{project}

# Firestore — Native 모드 DB 이름. Datastore Mode인 (default) 는 사용 불가
FIRESTORE_DATABASE=doc-state
FIRESTORE_COLLECTION=doc_state

# =============================================================================
# Vertex AI RAG Engine — 코퍼스
#
# 코퍼스는 둘이고 **포함 관계**
#
#   교직원 코퍼스 (RAG_CORPUS_NAME)          전체 = 학생자료 + 교직원자료
#   학생 코퍼스   (RAG_CORPUS_NAME_STUDENT)  STUDENT_FOLDER_IDS 트리만
#
# 즉 학생자료는 양쪽 모두에 실리고, 교직원자료는 교직원 코퍼스에만 실린다.
# 판정에 실패하거나 audience 필드가 없는 문서는 전부 STAFF 로 떨어진다 => 중요!
# (shared/models.py Audience). 틀리는 방향은 항상 '학생에게 안 보인다' 여야 함
# =============================================================================

# 교직원용(=전체) 코퍼스. **필수** — 코드가 `_env("RAG_CORPUS_NAME")` 으로 읽으며
# 없으면 서비스가 기동조차 못 한다(ValueError: Missing required env).
#
# 이름에 _STAFF 가 없는 이유: 이 변수는 rag-sync 와 rag-mcp 가 함께 쓴다. MCP 는
# 코퍼스 하나만 보므로(아래 MCP 절) 학생용 서비스에서는 여기에 학생 코퍼스를 넣는다.
# 즉 '기본 코퍼스' 자리이지 '교직원 코퍼스' 전용 자리가 아니다.
RAG_CORPUS_NAME=projects/{project}/locations/asia-northeast3/ragCorpora/{corpus-id}

# 학생 공개용 코퍼스. STUDENT_FOLDER_IDS 와 **둘 다** 채워야 분리가 켜진다
# (config.audience_split_enabled). 비우면 지금까지처럼 단일 코퍼스로 동작한다.
#
# 주의 — 이 변수는 **rag-sync 전용**이다. 학생용 MCP 서비스에서는 같은 코퍼스를
# 위 `RAG_CORPUS_NAME` 으로 넘긴다(아래 MCP 절 참고). 이름이 뒤바뀌는 지점이라
# 배포 스크립트에서 가장 틀리기 쉽다.
RAG_CORPUS_NAME_STUDENT=

# Document AI (optional; QG_MODE=fallback 일 때만)
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=asia-northeast3

# Drive
DRIVE_IDS=shared-drive-id-1,shared-drive-id-2
# 하위 폴더만 RAG/GCS. 폴더로 들어간 뒤 URL의 folders/ID.
#
# **비우면 드라이브 전체가 수집 대상이 된다.** 그게 기본값이라 조용히 넓어지는
# 쪽으로 실패한다 — deploy.sh 가 `${SYNC_FOLDER_IDS:-}` 로 넘기므로, 셸에 이 변수가
# 없으면(예: .env 에만 적어두고 export 를 안 하면) 빈 값으로 배포된다.
# 운영 값을 반드시 셸 환경에 올린 뒤 배포할 것.
SYNC_FOLDER_IDS=
# 이 폴더 트리 아래만 학생 코퍼스에 실린다. **SYNC_FOLDER_IDS 의 부분집합**이어야
# 한다 — 수집 범위 밖 폴더를 여기 적으면 그 문서는 애초에 수집되지 않아 학생
# 코퍼스도 비어 있게 된다.
# 여기 없는 문서는 전부 교직원 전용이며, 판정 실패도 교직원으로 떨어진다.
STUDENT_FOLDER_IDS=

# Parser (rhwp-python) quality gates
# G1: 추출 밀도 (텍스트 길이 / 원본 바이트)
QG_DENSITY_THRESHOLD=0.0005
# G2: 문서 구조상 표 N개 중 마크다운에 남지 않은 비율의 허용 상한
#     (구 QG_TABLE_FAIL_RATIO 대체 — 셀 단위 실패율은 그 지표를 채우는 파서가 없어
#      한 번도 발동하지 못했다. 빈 셀이 정상이라 '셀 실패'는 판별 자체가 불가능하다)
QG_TABLE_LOSS_RATIO=0.3
QG_MIN_TEXT_LENGTH=20
# log=경고만 색인 계속 | reject=422/DLQ | fallback=Document AI
QG_MODE=log
ENABLE_DOCAI_FALLBACK=false

MAX_GCS_BYTES=52428800
DLQ_COLLECTION=doc_dlq
SPLIT_QUEUE_COLLECTION=doc_split_queue
# Drive→GCS ingest 병렬 (무료/2Gi 기준)
RAW_UPLOAD_CONCURRENCY=8
# /sync/changes 가 한 번에 반환할 최대 변경 건수.
# Cloud Workflows 는 실행당 변수 누적 512KB 가 상한이고, 변경 1건이 응답·복사본·URI
# 까지 합쳐 ~900B 를 먹는다(≈586건에서 초과 → 실행 자체가 죽고 토큰 미커밋 → 다음
# 실행 델타가 더 커져 자력 회복 불가). 200건 ≈ 174KB 로 안전 마진을 둔다.
# 남은 분량은 hasMore 로 알리고 워크플로우가 이어서 처리한다.
SYNC_MAX_CHANGES=200

# =============================================================================
# MCP (FactChat 커넥터용 — scripts/deploy_mcp.sh)
#
# MCP 서버는 **기동 시점의 `RAG_CORPUS_NAME` 코퍼스 하나만** 본다. 툴 인자로
# 대상을 고르지 않는다 — 호출 LLM 이 정하는 값은 접근 통제가 될 수 없기 때문이다.
# 따라서 학생에게도 검색을 제공하려면 **서비스를 두 벌 띄운다.**
#
#   rag-mcp          RAG_CORPUS_NAME=<교직원 코퍼스>   MCP_API_KEY=<교직원 키>
#   rag-mcp-student  RAG_CORPUS_NAME=<학생 코퍼스>     MCP_API_KEY=<학생 키>
#                    ↑ RAG_CORPUS_NAME_STUDENT 가 아니라 RAG_CORPUS_NAME 이다
#
# deploy_mcp.sh 는 MCP_SERVICE_NAME / RAG_CORPUS_NAME / MCP_API_KEY 를 전부
# env 로 받으므로 **값만 바꿔 두 번 돌리면** 된다(이미지는 동일).
#
#   MCP_SERVICE_NAME=rag-mcp-student \
#   RAG_CORPUS_NAME="${RAG_CORPUS_NAME_STUDENT}" \
#   MCP_API_KEY="${MCP_API_KEY_STUDENT}" ./scripts/deploy_mcp.sh
#
# 키는 반드시 서비스마다 다른 값을 쓸 것. 같은 키를 쓰면 분리한 의미가 없다.
# =============================================================================

MCP_API_KEY=change-me-to-a-long-random-secret
# 학생용 MCP 서비스 키. 위 두 번째 배포에 쓴다. 분리를 안 켰으면 비워 둔다.
MCP_API_KEY_STUDENT=
# deploy_mcp.sh 가 만들 Cloud Run 서비스 이름(`${MCP_SERVICE_NAME:-rag-mcp}`).
# 학생용을 띄울 때만 rag-mcp-student 로 덮어쓴다 — 안 바꾸면 교직원 서비스를
# 학생 코퍼스로 덮어써 버린다.
MCP_SERVICE_NAME=rag-mcp
TOP_K_DEFAULT=5

# RAG 청킹 — 재색인해야 반영된다(기존 코퍼스 청크는 그대로).
# Vertex 기본값. 표가 청크 경계에서 잘리면 검색 시 절반만 걸리므로 512 에서 올렸다.
# 코퍼스가 바뀌면 scripts/analyze_chunking.py 로 표 절단율을 다시 재고 고를 것.
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=256

# =============================================================================
# 학생/교직원 분리를 켜는 절차
#
# 변수만 채운다고 학생 코퍼스가 차지 않는다. `audience` 는 **수집(ingest) 시점에만**
# 기록되는데(services/sync/main.py `_resolve_audience`), 이미 INDEXED 인 문서는
# ingest 초입에서 `UNCHANGED` 로 즉시 빠져나가 그 코드에 도달하지 못한다.
# `reindex-pending` 도 audience 를 다시 판정하지 않고 doc_state 값을 읽기만 한다.
#
# 즉 **기존 문서는 필드가 없어 전부 STAFF 로 읽히고, 학생 코퍼스는 계속 비어 있다.**
# 새로 들어오거나 내용이 바뀐 문서만 채워진다.
#
#   1) STUDENT_FOLDER_IDS / RAG_CORPUS_NAME_STUDENT 설정 후 rag-sync 재배포
#   2) 기존 문서의 audience 를 일괄 판정해 doc_state 에 기록
#      (폴더 조상 탐색 배치. scripts/migrate_excluded_status.py 와 같은 꼴)
#   3) 학생 코퍼스 적재 — 2 없이 하면 결과가 빈 코퍼스다
#   4) 학생용 MCP 서비스 배포 (위 MCP 절)
#
# 순서를 지킬 것. 4를 먼저 하면 학생에게 빈 검색을 주게 된다.
# =============================================================================
