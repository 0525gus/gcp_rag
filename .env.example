# =============================================================================
# 읽는 법
#   [필수]   없으면 배포 또는 기동이 실패한다
#   [배포]   deploy.sh 가 Cloud Run 에 넘긴다 — 여기 값이 곧 운영 값
#   [코드]   어떤 배포 스크립트도 안 넘긴다. 여기서 바꿔도 **서비스에 반영 안 됨**
#            (바꾸려면 deploy.sh 의 --set-env-vars 에 추가해야 한다)
#
# 주의
#   - deploy.sh 는 --set-env-vars 로 env 를 통째로 치환한다. 안 넘긴 값은 사라진다
#   - 값에 따옴표를 쓰지 말 것 (일부 도구가 따옴표째 읽는다)
#   - 같은 변수를 두 번 적지 말 것 (로더마다 이기는 쪽이 다르다)
# =============================================================================

# --- GCP [필수] --------------------------------------------------------------
GCP_PROJECT_ID=your-project-id
# [배포]
GCP_REGION=asia-northeast3

# --- 버킷 [필수] -------------------------------------------------------------
GCS_RAW_BUCKET=rag-raw-{project}
GCS_NORMALIZED_BUCKET=rag-normalized-{project}

# --- Firestore [배포] --------------------------------------------------------
# Native 모드 DB. Datastore Mode 인 (default) 는 사용 불가
FIRESTORE_DATABASE=doc-state
FIRESTORE_COLLECTION=doc_state

# --- 코퍼스 -------------------------------------------------------------------
# [필수] 서비스가 볼 코퍼스. rag-sync 는 교직원(=전체), 학생용 MCP 는 학생 코퍼스를
#        이 이름으로 받는다. '기본 코퍼스' 자리이지 '교직원 전용' 자리가 아니다
RAG_CORPUS_NAME=projects/{project}/locations/asia-northeast3/ragCorpora/{corpus-id}

# [배포] 학생 공개용. STUDENT_FOLDER_IDS 와 **둘 다** 채워야 분리가 켜진다
#        비우면 단일 코퍼스로 동작 (현행)
RAG_CORPUS_NAME_STUDENT=

# --- Drive [배포] -------------------------------------------------------------
DRIVE_IDS=shared-drive-id-1,shared-drive-id-2

# 수집 대상 폴더. **비우면 드라이브 전체가 대상이 된다**
# 폴더 URL 의 folders/ 뒤 ID
SYNC_FOLDER_IDS=

# 학생 코퍼스에 실릴 폴더. SYNC_FOLDER_IDS 의 부분집합이어야 한다
# 여기 없으면 교직원 전용. 판정 실패도 교직원으로 떨어진다
STUDENT_FOLDER_IDS=

# --- 파서 [배포] ---------------------------------------------------------------
# log=경고만 색인 계속 | reject=422/DLQ | fallback=Document AI
QG_MODE=log
# Document AI (QG_MODE=fallback 일 때만)
DOCAI_PROCESSOR_ID=

# --- 처리량 [배포] -------------------------------------------------------------
# Drive→GCS ingest 병렬 워커
RAW_UPLOAD_CONCURRENCY=8

# RagFile 삭제 속도. 소모율 ≈ 동시수 / (0.4 + 페이싱) 건/초
#   1 / 1.1  = 0.67건/초  기본값, 60rpm 쿼터 기준
#   4 / 0.6  = 4.0건/초   300rpm 쿼터 상향 후
# **쿼터를 안 올린 채 올리면 429 가 쏟아진다.** 프로젝트를 옮기면 쿼터는 초기화된다
RAG_DELETE_CONCURRENCY=1
RAG_DELETE_PACING_SECONDS=1.1

# --- MCP -----------------------------------------------------------------------
# 이 파일은 '출처' 이름을 쓰고, 서비스는 '역할' 이름(MCP_API_KEY)을 읽는다.
# MCP 서버는 어느 대상을 서빙하든 MCP_API_KEY 하나만 보므로(코드 제약),
# 배포 스크립트가 _STAFF → MCP_API_KEY 로 옮긴다
#
# [필수] 교직원(기본) 서비스 키
MCP_API_KEY_STAFF=change-me-to-a-long-random-secret

# [배포] 학생용 서비스에 넘길 키. **MCP_API_KEY_STAFF 와 반드시 다른 값**
# Cloud Run URL 은 서비스 이름만 다르므로(rag-mcp-XXXX / rag-mcp-student-XXXX)
# 자기 URL 에서 상대편 주소를 유추할 수 있다 — 경계는 키뿐이다
MCP_API_KEY_STUDENT=

# MCP_SERVICE_NAME 은 여기 적지 않는다
#   배포될 Cloud Run 서비스 이름을 고르는 값이라(기본 rag-mcp), .env 에 남으면
#   이후 모든 배포가 그리로 간다. 학생용을 띄우고 지우지 않으면 다음 교직원 배포가
#   학생 서비스를 교직원 코퍼스로 덮어쓴다. 필요할 때 그 실행에만 붙일 것

# --- 검색 [배포] ---------------------------------------------------------------
TOP_K_DEFAULT=5
# retrieve 여유분. postprocess 가 파일 단위로 접으므로 k 보다 많이 뽑아야 한다
SEARCH_FETCH_MULTIPLIER=3
SEARCH_FETCH_MAX=60

# =============================================================================
# [코드] 아래는 어떤 배포 스크립트도 넘기지 않는다.
#        여기서 바꿔도 배포된 서비스는 코드 기본값을 쓴다.
#        실제로 바꾸려면 deploy.sh 의 --set-env-vars 에 먼저 추가할 것.
# =============================================================================

# 파일 크기 상한. RAG import 한도(.pdf/.docx 50MB, 그 외 10MB)와 별개인 '우리' 상한
# PDF 분할을 쓰려면 이 값이 RAG PDF 한도(50MB)보다 커야 한다 — 같으면 분할 구간이
# 열리지 않는다
MAX_GCS_BYTES=52428800

# /sync/changes 가 한 번에 반환할 변경 건수
# Cloud Workflows 는 실행당 변수 512KB 가 상한, 변경 1건이 ~900B (≈586건에서 초과)
SYNC_MAX_CHANGES=200

# RAG 청킹. 재색인해야 반영된다 (기존 청크는 그대로)
# 코퍼스가 바뀌면 scripts/analyze_chunking.py 로 표 절단율을 재고 고를 것
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=256

# 품질 게이트 임계값
QG_DENSITY_THRESHOLD=0.0005
QG_TABLE_LOSS_RATIO=0.3
QG_MIN_TEXT_LENGTH=20
ENABLE_DOCAI_FALLBACK=false
DOCAI_LOCATION=asia-northeast3

# 검색 후처리
SEARCH_TOP_K_MAX=20
# 벡터 거리 상한. 이보다 먼 청크는 버린다 (0 이면 필터 끔)
SEARCH_DISTANCE_THRESHOLD=0.30
SEARCH_LEXICAL_RERANK=true
SEARCH_MAX_CHUNKS_PER_FILE=3
SEARCH_MAX_TOTAL_CHUNKS=15

# 컬렉션 이름
DLQ_COLLECTION=doc_dlq
SPLIT_QUEUE_COLLECTION=doc_split_queue
SYNC_TOKEN_COLLECTION=sync_tokens

# =============================================================================
# 학생/교직원 분리를 켜는 절차
#
# 코퍼스는 포함 관계다 — 교직원(전체) ⊇ 학생(STUDENT_FOLDER_IDS 트리)
# MCP 서버는 기동 시점의 코퍼스 하나만 본다. 툴 인자로 대상을 고르지 않는다
# (호출 LLM 이 정하는 값은 접근 통제가 될 수 없다). 그래서 **서비스를 두 벌 띄운다**
#
#   1) STUDENT_FOLDER_IDS / RAG_CORPUS_NAME_STUDENT 설정 후 rag-sync 재배포
#   2) 기존 문서의 audience 를 일괄 판정해 doc_state 에 기록
#      - audience 는 ingest 시점에만 기록된다(_resolve_audience)
#      - 이미 INDEXED 인 문서는 ingest 초입에서 UNCHANGED 로 빠져 그 코드에 못 간다
#      - reindex-pending 도 audience 를 다시 판정하지 않는다
#      - **이 단계를 건너뛰면 학생 코퍼스는 빈 채로 동작한다**
#   3) 학생 코퍼스 적재
#   4) 학생용 MCP 배포 — 값만 바꿔 두 번째로 돌린다
#        MCP_SERVICE_NAME=rag-mcp-student \
#        RAG_CORPUS_NAME="${RAG_CORPUS_NAME_STUDENT}" \
#        MCP_API_KEY="${MCP_API_KEY_STUDENT}" ./scripts/deploy_mcp.sh
#
# 순서를 지킬 것. 4 를 먼저 하면 학생에게 빈 검색을 준다
# =============================================================================
